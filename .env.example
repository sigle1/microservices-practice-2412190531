MYSQL_ROOT_PASSWORD=change_this_root_password
USER_DB_PASSWORD=change_this_user_password
PET_DB_PASSWORD=change_this_pet_password
APPOINTMENT_DB_PASSWORD=change_this_appointment_password

# Generate with: openssl rand -base64 32
NACOS_AUTH_TOKEN=replace_with_a_base64_encoded_secret_at_least_32_bytes
# Generate with: openssl rand -hex 16
NACOS_AUTH_IDENTITY_KEY=petcareServerIdentity
NACOS_AUTH_IDENTITY_VALUE=replace_with_a_random_identity_value
NACOS_PASSWORD=replace_with_the_nacos_admin_password
NACOS_USERNAME=nacos
# Leave empty for the public namespace, or paste the Namespace ID from the console.
NACOS_NAMESPACE=
NACOS_GROUP=PERSONAL_GROUP

NACOS_CONSOLE_PORT=18080
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
USER_PORT=8081
PET_PORT=8082
APPOINTMENT_PORT=8083
